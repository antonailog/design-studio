{
 "_说明": "个人博客（阿東的AI手记）的 design-studio 站点配置的回归副本。真源是博客里的 99-其他/design-studio.json（10-23 起），那边改了要同步过来。base 指回博客根目录。字段说明见 docs/config.md。",
 "base": "..",
 "static_root": "4-页面",
 "port": 4580,
 "editor_mount": "/编辑器/",
 "root_redirect": "首页",
 "sheet_dir": "0-记录/修改单",
 "feedback_dir": "0-记录/修改单/反馈",
 "pages": {
  "首页": {
   "url": "/首页/首页-v3/v3-7.html",
   "html": "4-页面/首页/首页-v3/v3-7.html",
   "data": "4-页面/首页/首页-v3/data/site.js",
   "sheet": "0-记录/修改单/首页.json",
   "guide": "4-页面/首页/修改指南.md",
   "skip": ["nav", "manifesto", "featured", "tags"]
  }
 },
 "after_save": {
  "label": "脱敏扫描",
  "cmd": ["{python}", "-I", "99-其他/脚本/脱敏扫描.py", "{file}"],
  "ignore_prefixes": ["扫了"],
  "timeout": 60
 },
 "text": {
  "skip_leaf": ["id", "url", "src", "href", "poster", "cover", "image", "qr", "page", "page_base", "avatar", "avatar_note", "domain", "kind", "type", "repo"],
  "section_keys": {
   "首屏": ["person", "picks", "contact"],
   "作品": ["stats"],
   "项目": ["projects"],
   "Skill": ["skills"],
   "小工具": ["tools"],
   "文章": ["articles"],
   "近况": ["now", "milestones"],
   "联系": ["contact", "person"]
  },
  "follow": [
   ["^person\\.tagline$", "口号在哪换行、高亮哪几个字写死在页面脚本 const tag，要同步改"],
   ["^person\\.name$", "中文名字号按 6 个字算（--name-fs），字数变了要调"],
   ["^person\\.name_en$", "页面上的英文签名是手写路径，只改这个字段看不出变化，要重新生成签名"],
   ["^person\\.about\\.", "对外履历的源头在 3-对外/履历/履历.md，要同步过去"],
   ["^picks\\.\\d+\\.(hook|title)$", "首页精选文案的源头在 3-对外/项目/首页精选.md，要同步过去"],
   ["\\.tag$", "方向标签只能从标签表里选（3-对外/项目/首页精选.md）"]
  ],
  "allowed_tags": ["b", "strong", "em"]
 },
 "editor": {
  "title": "页面编辑器",
  "viewports": [
   {"w": 1440, "h": 900, "label": "桌面 1440"},
   {"w": 1280, "h": 800, "label": "笔记本 1280"},
   {"w": 390, "h": 844, "label": "手机 390"}
  ],
  "theme": {"storage_key": "v2-theme", "attr": "data-theme", "light": "light", "dark": "dark"},
  "sections": {"top": "首屏", "works": "作品", "projects": "项目", "skills": "Skill", "tools": "小工具", "writing": "文章", "now": "近况", "contact": "联系"},
  "section_extra": [{"sel": ".topbar", "name": "顶栏"}, {"sel": "footer", "name": "页脚"}],
  "known": [
   {"sel": ".topbar", "name": "顶栏", "num": 1},
   {"sel": ".h4-years", "name": "年份行", "num": 8},
   {"sel": ".h4-about", "name": "自我介绍", "num": 7},
   {"sel": "#zhName", "name": "中文名", "num": 3, "hint": "person.name"},
   {"sel": "#sig", "name": "英文签名", "num": 4},
   {"sel": ".h4-soc", "name": "社交图标", "num": 5},
   {"sel": ".h4-quote", "name": "宣言", "num": 6, "hint": "person.tagline"},
   {"sel": "#ava", "name": "头像", "num": 2},
   {"sel": ".stk-bar", "name": "指示条", "num": 10},
   {"sel": "#picks", "name": "精选卡堆", "num": 9}
  ],
  "hint_rules": [
   {"selector": ".h4-about > p:not(.h4-years)", "siblings": ":scope > p:not(.h4-years)", "hint": "person.about.{i}"}
  ],
  "ignore_classes": "^(is-|rv$|in$|on$|open$|done$|tick$|active$)",
  "inline_format_classes": ["bt-seg", "mark"],
  "styles": {
   "sizes": ["--fs-12", "--fs-13", "--fs-14", "--fs-15", "--fs-17", "--fs-20", "--fs-24", "--fs-32", "--fs-h4", "--fs-h2", "--fs-stat"],
   "spaces": ["--sp-2", "--sp-4", "--sp-6", "--sp-8", "--sp-10", "--sp-12", "--sp-14", "--sp-16", "--sp-18", "--sp-20", "--sp-24", "--sp-28", "--sp-32", "--sp-40", "--sp-48", "--sp-64", "--sp-88", "--sp-128"],
   "radii": ["--r-xs", "--r-sm", "--r-in", "--r", "--r-pill"],
   "line_heights": ["--lh-display", "--lh-title", "--lh-ui", "--lh-text", "--lh-body"],
   "font_weights": [["300", "细 300"], ["400", "常规 400"], ["500", "中 500"], ["600", "粗 600"]],
   "fonts": [["--font-title", "标题字（姓名、板块标题）"], ["--font-zh", "中文细体（宣言）"], ["--font-latin", "英文和数字"], ["--font-body", "正文"], ["--font-mono", "等宽"]],
   "text_colors": ["--fg", "--fg-2", "--muted", "--accent-ink", "--accent"],
   "bg_colors": ["none", "--bg", "--surface", "--surface-2", "--accent-soft", "--accent"],
   "color_names": {"--fg": "主文字", "--fg-2": "次文字", "--muted": "说明灰", "--accent-ink": "墨绿", "--accent": "黄绿", "--bg": "页面底", "--surface": "卡片白", "--surface-2": "浅灰", "--accent-soft": "浅黄绿", "--line": "细线", "--line-strong": "深一点的线"}
  }
 },
 "scale": {
  "_说明": "字号收敛页 /编辑器/scale.html（10-24 起，原 4-页面/设计规范/字号调整台.html 搬进 design-studio）。方案 A 是 10-24 用户选定的；报告在 0-记录/讨论/2026-10-23-字号收敛审查.md",
  "pages": {
   "Skill 页 · 总览": "/skill-showcase/v10.html",
   "Skill 页 · Forge 集合": "/skill-showcase/v10.html#forge",
   "Skill 页 · 单个 Skill": "/skill-showcase/v10.html#book-to-mindmap",
   "文章页 · 04-10": "/posts/2026-04-10/",
   "文章页 · 03-29": "/posts/2026-03-29/",
   "文章页 · 03-01": "/posts/2026-03-01/",
   "文章页 · 02-25": "/posts/2026-02-25/",
   "文章页 · 02-20": "/posts/2026-02-20/",
   "文章页 · 02-19": "/posts/2026-02-19/",
   "文章页 · 02-16": "/posts/2026-02-16/"
  },
  "keep": [".zh-name, .zh-name *, .bt-seg, .h4-quote, .h4-quote *, .h2, .h2 *", ".stat .num, .stk-nums b, .stk-nums b *, .bignum b, .bignum b *, .hollow", ".pcard-txt h4, .skg-name, .skg-name *, .page-h1, .vc-name, .tls-shot pre, .tls-shot pre *", ".philo-lead .q, .philo-lead p", ".mono-mark, .stk-nums b em, .bignum b em, .prose code, .zip code, .limits code, .md code"],
  "keep_from": 34,
  "lock": [
   {"selector": ".prose, .prose *, .lede, .lede *", "min": 16, "max": 17.5, "why": "文章正文和导语（桌面 17px、手机 16.5px，10-23 在文章页调整台定的）保持原样"}
  ],
  "presets": [
   {"name": "A 轻收敛", "recommend": true, "note": "8 档。小数并到最近的一档，11 及以下抬到 12，16 并进 15，18—21 并成 20，22—26 并成 24，28—32 并成 32。多数文字只差 0.5—2px，版式风险小。",
    "steps": [[12, "等宽小字：标签、日期、徽章、计数"], [13, "次要说明：键值的键、图注、侧栏列表"], [14, "界面字：导航、按钮、页签、卡片说明"], [15, "卡片和列表正文"], [17, "阅读正文：首屏介绍、文章正文"], [20, "小标题：文章列表标题、Skill 页小节"], [24, "卡片标题：项目名、Skill 卡名、站名、文章小节"], [32, "页内大标题：文章标题、Skill 页分节"]],
    "upto": [[12.5, 12], [13.5, 13], [14.5, 14], [16, 15], [17.5, 17], [21.5, 20], [26, 24], [33, 32]]},
   {"name": "B 重收敛", "note": "6 档，相邻两档差得更开、层级更分明。13 升到 14、15 升到 16，改动面大：项目卡高度和首屏 1440×900 一屏放下都要重验。",
    "steps": [[12, "小字：标签、日期、键值、图注"], [14, "界面字和卡片说明"], [16, "正文（文章正文仍是 17）"], [20, "小标题"], [24, "卡片标题"], [32, "页内大标题"]],
    "upto": [[12.5, 12], [14.5, 14], [17.5, 16], [21.5, 20], [26, 24], [33, 32]]}
  ],
  "feedback": "字号收敛"
 }
}
